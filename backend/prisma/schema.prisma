// Simplified Rydora database schema
// Prisma ORM 7 + PostgreSQL

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  USER
  DRIVER
}

enum RideStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

enum BookingStatus {
  PENDING
  COMPLETED
  CANCELLED
}

enum TransactionType {
  PAYMENT
  REFUND
}
