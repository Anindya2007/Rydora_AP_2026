generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================
// ENUMS (PART 1: IDENTITY & COMMUNITIES)
// ==========================================

enum AccountStatus {
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

enum RoleType {
  RIDER
  DRIVER
  ADMIN
}

enum ThemeType {
  LIGHT
  DARK
  SYSTEM
}

enum CommunityType {
  UNIVERSITY
  OFFICE
  NEIGHBORHOOD
  PRIVATE
}

enum CommunityStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum MembershipStatus {
  PENDING
  ACTIVE
  REJECTED
  REVOKED
}

enum CommunityRole {
  MEMBER
  MODERATOR
  ADMIN
}

enum VerificationStatus {
  NOT_STARTED
  PENDING
  VERIFIED
  REJECTED
  NOT_REQUIRED
}

enum VerificationMethod {
  EMAIL_DOMAIN
  INVITE_CODE
  MANUAL
}

enum VerificationAttemptStatus {
  PENDING
  VERIFIED
  REJECTED
  EXPIRED
}

// ==========================================
// ENUMS (PART 2: VEHICLES & DRIVERS)
// ==========================================

enum VehicleType {
  SEDAN
  HATCHBACK
  SUV
  MOTORCYCLE
  VAN
  OTHER
}

enum DriverEligibilityStatus {
  ELIGIBLE
  INELIGIBLE
  PENDING_REVIEW
  SUSPENDED
}

enum VehicleDocumentType {
  REGISTRATION_CERTIFICATE
  INSURANCE
  POLLUTION_FITNESS
  COMMERCIAL_PERMIT
  OTHER
}

enum DocumentVerificationStatus {
  PENDING
  VERIFIED
  REJECTED
  EXPIRED
}

// ==========================================
// ENUMS (PART 3: RIDES & ROUTES)
// ==========================================

enum RideStatus {
  SCHEDULED
  ACTIVE
  COMPLETED
  CANCELLED
}

enum StopType {
  PICKUP
  DROPOFF
  WAYPOINT
}

// ==========================================
// ENUMS (PART 4: BOOKINGS & CANCELLATIONS)
// ==========================================

enum BookingStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
  EXPIRED
}

enum FareQuoteStatus {
  ACTIVE
  ACCEPTED
  EXPIRED
  REJECTED
}

enum FareLineItemType {
  BASE_FARE
  DISTANCE_FARE
  TIME_FARE
  PLATFORM_FEE
  COMMUNITY_DISCOUNT
  SURGE
  TAX
  OTHER
}

enum ResponsibleParty {
  RIDER
  DRIVER
  PLATFORM
}

enum NoShowStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum PenaltyAssessmentStatus {
  PENDING
  WAIVED
  APPLIED
  DISPUTED
}

enum DisputeStatus {
  OPEN
  UNDER_REVIEW
  RESOLVED
  REJECTED
}

// ==========================================
// ENUMS (PART 5: PAYMENTS & FINANCIAL LEDGER)
// ==========================================

enum PaymentMethod {
  CARD
  UPI
  NET_BANKING
  WALLET
  SIMULATED
}

enum PaymentStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum RefundStatus {
  PENDING
  PROCESSING
  SUCCEEDED
  FAILED
}

enum FinancialAccountType {
  USER_WALLET
  DRIVER_ESCROW
  PLATFORM_TREASURY
}

enum FinancialAccountStatus {
  ACTIVE
  FROZEN
  CLOSED
}

enum LedgerTransactionType {
  RIDE_PAYMENT
  DRIVER_PAYOUT
  PLATFORM_COMMISSION
  REFUND
  PENALTY
  INCENTIVE
}

enum LedgerEntryType {
  DEBIT
  CREDIT
}

enum DriverEarningStatus {
  PENDING
  AVAILABLE
  PAID_OUT
  WITHHELD
}

// ==========================================
// ENUMS (PART 6: SAFETY, RATINGS & TRUST)
// ==========================================

enum IncidentSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum IncidentStatus {
  REPORTED
  INVESTIGATING
  RESOLVED
  DISMISSED
}

enum IncidentCategory {
  HARASSMENT
  RECKLESS_DRIVING
  ROUTE_DEVIATION
  VEHICLE_CONDITION
  PAYMENT_DISPUTE
  OTHER
}

enum SOSAlertStatus {
  TRIGGERED
  ACKNOWLEDGED
  RESOLVED
  FALSE_ALARM
}

enum DeviationStatus {
  DETECTED
  ACKNOWLEDGED
  RESOLVED
  FALSE_POSITIVE
}

enum ConsentType {
  LOCATION_TRACKING
  EMERGENCY_CONTACT_SHARING
  AUDIO_RECORDING
  MARKETING_COMMUNICATION
}

enum SentimentLabel {
  POSITIVE
  NEUTRAL
  NEGATIVE
}

enum ModerationTargetType {
  USER
  REVIEW
  COMMUNITY
  CHAT
}

enum ModerationStatus {
  PENDING
  INVESTIGATING
  RESOLVED
  DISMISSED
}

enum IncentiveStatus {
  ACTIVE
  COMPLETED
  EXPIRED
  CANCELLED
}

// ==========================================
// ENUMS (PART 7: NOTIFICATIONS, AI, SUSTAINABILITY & ADMIN)
// ==========================================

enum NotificationType {
  RIDE_UPDATE
  BOOKING_CONFIRMATION
  SAFETY_ALERT
  PAYMENT_RECEIPT
  COMMUNITY_ANNOUNCEMENT
  REWARD_EARNED
  SYSTEM
}

enum NotificationChannel {
  IN_APP
  EMAIL
  SMS
  PUSH
}

enum DeliveryStatus {
  PENDING
  SENT
  DELIVERED
  FAILED
}

enum CalendarProvider {
  GOOGLE
  OUTLOOK
  APPLE
}

enum AISessionType {
  RIDE_ASSISTANT
  SUPPORT_CHATBOT
  ROUTE_OPTIMIZER
}

enum AIMessageRole {
  SYSTEM
  USER
  ASSISTANT
}

enum GreenPointType {
  RIDE_SHARED
  ZERO_EMISSION_BONUS
  COMMUNITY_BONUS
  REWARD_REDEMPTION
  ADJUSTMENT
}

enum RedemptionStatus {
  PENDING
  FULFILLED
  CANCELLED
  EXPIRED
}

// ==========================================
// MODELS (PART 1: IDENTITY & COMMUNITIES)
// ==========================================

model User {
  userId          String        @id @default(uuid()) @db.Uuid
  name            String        @db.VarChar(100)
  email           String        @unique @db.VarChar(255)
  phone           String?       @unique @db.VarChar(20)
  phoneVerifiedAt DateTime?
  passwordHash    String
  profileImage    String?
  accountStatus   AccountStatus @default(ACTIVE)
  emailVerifiedAt DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  deletedAt       DateTime?

  // Inverse Relations (Part 1)
  roles                 UserRole[]
  sessions              UserSession[]
  emailVerifications    EmailVerification[]
  passwordResetTokens   PasswordResetToken[]
  phoneVerifications    PhoneVerification[]
  preference            UserPreference?
  createdCommunities    Community[]             @relation("CommunityCreatedBy")
  memberships           CommunityMembership[]
  invitesCreated        CommunityInvite[]       @relation("InviteCreatedBy")
  verificationsReviewed CommunityVerification[] @relation("VerificationReviewedBy")

  // Inverse Relations (Part 2)
  vehicles                 Vehicle[]
  driverProfile            DriverProfile?
  vehicleDocumentsReviewed VehicleDocument[] @relation("VehicleDocumentReviewedBy")

  // Inverse Relations (Part 3)
  ridesDriven Ride[] @relation("DriverRides")

  // Inverse Relations (Part 4)
  bookings          Booking[]      @relation("RiderBookings")
  fareQuotes        FareQuote[]    @relation("RiderFareQuotes")
  cancellations     Cancellation[] @relation("CancellationsPerformed")
  noShowsReported   NoShowRecord[] @relation("NoShowsReported")
  disputesSubmitted DisputeCase[]  @relation("DisputesSubmitted")
  disputesReviewed  DisputeCase[]  @relation("DisputesReviewed")

  // Inverse Relations (Part 5)
  payments         Payment[]         @relation("UserPayments")
  refundsRequested Refund[]          @relation("RefundsRequested")
  financialAccount FinancialAccount?
  driverEarnings   DriverEarning[]   @relation("DriverEarnings")

  // Inverse Relations (Part 6)
  trustedContacts         TrustedContact[]     @relation("UserTrustedContacts")
  incidentsReported       SafetyIncident[]     @relation("ReportedIncidents")
  incidentsAgainst        SafetyIncident[]     @relation("IncidentsAgainstUser")
  incidentsResolved       SafetyIncident[]     @relation("ResolvedIncidents")
  sosAlertsTriggered      SOSAlert[]           @relation("SOSAlertsTriggered")
  sosAlertsResolved       SOSAlert[]           @relation("SOSAlertsResolved")
  evidenceUploaded        SafetyEvidence[]     @relation("EvidenceUploaded")
  consents                ConsentRecord[]      @relation("UserConsents")
  ratingsGiven            Rating[]             @relation("RatingsGiven")
  ratingsReceived         Rating[]             @relation("RatingsReceived")
  moderationReportsFiled  ModerationReport[]   @relation("ModerationReportsFiled")
  moderationReportsHandled ModerationReport[]  @relation("ModerationReportsHandled")
  tierHistories           DriverTierHistory[]  @relation("DriverTierHistories")
  incentives              DriverIncentive[]    @relation("DriverIncentives")

  // Inverse Relations (Part 7)
  notifications           Notification[]          @relation("UserNotifications")
  notificationPreference  NotificationPreference?
  calendarConnections     CalendarConnection[]    @relation("UserCalendarConnections")
  aiSessions              AISession[]             @relation("UserAISessions")
  greenPoints             GreenPointTransaction[] @relation("UserGreenPoints")
  rewardRedemptions       RewardRedemption[]      @relation("UserRewardRedemptions")
  adminAuditLogs          AdminAuditLog[]         @relation("AdminAuditLogs")
  platformSettingsUpdated PlatformSetting[]       @relation("PlatformSettingsUpdated")

  @@map("users")
}

model UserRole {
  roleId    String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  role      RoleType
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@unique([userId, role])
  @@index([userId])
  @@map("user_roles")
}

model UserSession {
  sessionId        String    @id @default(uuid()) @db.Uuid
  userId           String    @db.Uuid
  refreshTokenHash String    @unique
  deviceInfo       String?
  ipAddress        String?   @db.VarChar(45)
  expiresAt        DateTime
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())

  user User @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@index([userId])
  @@map("user_sessions")
}

model EmailVerification {
  verificationId String    @id @default(uuid()) @db.Uuid
  userId         String    @db.Uuid
  tokenHash      String    @unique
  expiresAt      DateTime
  usedAt         DateTime?
  createdAt      DateTime  @default(now())

  user User @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@index([userId])
  @@map("email_verifications")
}

model PasswordResetToken {
  resetId   String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

model PhoneVerification {
  verificationId String    @id @default(uuid()) @db.Uuid
  userId         String    @db.Uuid
  phone          String    @db.VarChar(20)
  otpHash        String
  expiresAt      DateTime
  verifiedAt     DateTime?
  attemptCount   Int       @default(0)
  createdAt      DateTime  @default(now())

  user User @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@index([userId])
  @@map("phone_verifications")
}

model UserPreference {
  preferenceId          String    @id @default(uuid()) @db.Uuid
  userId                String    @unique @db.Uuid
  language              String    @default("en") @db.VarChar(10)
  theme                 ThemeType @default(SYSTEM)
  accessibilitySettings Json?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@map("user_preferences")
}

model Community {
  communityId    String          @id @default(uuid()) @db.Uuid
  name           String          @db.VarChar(150)
  type           CommunityType
  description    String?
  status         CommunityStatus @default(ACTIVE)
  isDiscoverable Boolean         @default(true)
  createdById    String          @db.Uuid
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  createdBy       User                  @relation("CommunityCreatedBy", fields: [createdById], references: [userId], onDelete: Restrict)
  memberships     CommunityMembership[]
  domains         CommunityDomain[]
  invites         CommunityInvite[]
  rideCommunities RideCommunity[]

  @@index([createdById])
  @@index([type, status])
  @@map("communities")
}

model CommunityMembership {
  membershipId       String              @id @default(uuid()) @db.Uuid
  userId             String              @db.Uuid
  communityId        String              @db.Uuid
  membershipStatus   MembershipStatus    @default(PENDING)
  membershipRole     CommunityRole       @default(MEMBER)
  verificationStatus VerificationStatus  @default(PENDING)
  verificationMethod VerificationMethod?
  verifiedAt         DateTime?
  joinedAt           DateTime?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  user          User                    @relation(fields: [userId], references: [userId], onDelete: Cascade)
  community     Community               @relation(fields: [communityId], references: [communityId], onDelete: Cascade)
  verifications CommunityVerification[]

  @@unique([userId, communityId])
  @@index([communityId, membershipStatus])
  @@index([userId])
  @@map("community_memberships")
}

model CommunityDomain {
  domainId    String    @id @default(uuid()) @db.Uuid
  communityId String    @db.Uuid
  domain      String    @db.VarChar(255)
  isActive    Boolean   @default(true)
  approvedAt  DateTime?
  createdAt   DateTime  @default(now())

  community Community @relation(fields: [communityId], references: [communityId], onDelete: Cascade)

  @@unique([communityId, domain])
  @@index([domain])
  @@map("community_domains")
}

model CommunityInvite {
  inviteId         String    @id @default(uuid()) @db.Uuid
  communityId      String    @db.Uuid
  createdById      String    @db.Uuid
  codeHash         String    @unique
  emailRestriction String?   @db.VarChar(255)
  maxUses          Int?
  useCount         Int       @default(0)
  expiresAt        DateTime?
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())

  community Community @relation(fields: [communityId], references: [communityId], onDelete: Cascade)
  createdBy User      @relation("InviteCreatedBy", fields: [createdById], references: [userId], onDelete: Restrict)

  @@index([communityId])
  @@index([createdById])
  @@map("community_invites")
}

model CommunityVerification {
  verificationId String                    @id @default(uuid()) @db.Uuid
  membershipId   String                    @db.Uuid
  method         VerificationMethod
  status         VerificationAttemptStatus @default(PENDING)
  reviewerId     String?                   @db.Uuid
  reviewedAt     DateTime?
  reason         String?
  metadata       Json?
  createdAt      DateTime                  @default(now())

  membership CommunityMembership @relation(fields: [membershipId], references: [membershipId], onDelete: Cascade)
  reviewer   User?               @relation("VerificationReviewedBy", fields: [reviewerId], references: [userId], onDelete: SetNull)

  @@index([membershipId])
  @@index([reviewerId])
  @@map("community_verifications")
}

// ==========================================
// MODELS (PART 2: VEHICLES & DRIVERS)
// ==========================================

model Vehicle {
  vehicleId          String             @id @default(uuid()) @db.Uuid
  ownerId            String             @db.Uuid
  vehicleType        VehicleType
  registrationNumber String             @unique @db.VarChar(50)
  make               String             @db.VarChar(50)
  model              String             @db.VarChar(50)
  color              String             @db.VarChar(30)
  seatCapacity       Int
  verificationStatus VerificationStatus @default(NOT_STARTED)
  isActive           Boolean            @default(true)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  owner     User              @relation(fields: [ownerId], references: [userId], onDelete: Cascade)
  documents VehicleDocument[]
  rides     Ride[]

  @@index([ownerId])
  @@index([registrationNumber, isActive])
  @@map("vehicles")
}

model DriverProfile {
  driverProfileId           String                  @id @default(uuid()) @db.Uuid
  userId                    String                  @unique @db.Uuid
  driverVerificationStatus  VerificationStatus      @default(NOT_STARTED)
  licenseVerificationStatus VerificationStatus      @default(NOT_STARTED)
  licenseNumber             String?                 @db.VarChar(50)
  eligibilityStatus         DriverEligibilityStatus @default(PENDING_REVIEW)
  approvedAt                DateTime?
  createdAt                 DateTime                @default(now())
  updatedAt                 DateTime                @updatedAt

  user User @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@index([eligibilityStatus])
  @@map("driver_profiles")
}

model VehicleDocument {
  documentId         String                     @id @default(uuid()) @db.Uuid
  vehicleId          String                     @db.Uuid
  documentType       VehicleDocumentType
  fileUrl            String                     @db.VarChar(500)
  verificationStatus DocumentVerificationStatus @default(PENDING)
  reviewedById       String?                    @db.Uuid
  reviewedAt         DateTime?
  expiresAt          DateTime?
  rejectionReason    String?
  createdAt          DateTime                   @default(now())
  updatedAt          DateTime                   @updatedAt

  vehicle  Vehicle @relation(fields: [vehicleId], references: [vehicleId], onDelete: Cascade)
  reviewer User?   @relation("VehicleDocumentReviewedBy", fields: [reviewedById], references: [userId], onDelete: SetNull)

  @@index([vehicleId])
  @@index([reviewedById])
  @@map("vehicle_documents")
}

// ==========================================
// MODELS (PART 3: RIDES & ROUTES)
// ==========================================

model Ride {
  rideId                 String     @id @default(uuid()) @db.Uuid
  driverId               String     @db.Uuid
  vehicleId              String     @db.Uuid
  originAddress          String     @db.VarChar(255)
  originLat              Float
  originLng              Float
  originPlaceId          String?    @db.VarChar(255)
  destinationAddress     String     @db.VarChar(255)
  destinationLat         Float
  destinationLng         Float
  destinationPlaceId     String?    @db.VarChar(255)
  departureTime          DateTime
  totalSeats             Int
  availableSeats         Int
  farePerSeat            Decimal    @db.Decimal(10, 2)
  rideStatus             RideStatus @default(SCHEDULED)
  plannedDistanceKm      Decimal?   @db.Decimal(8, 2)
  plannedDurationMinutes Int?
  notes                  String?
  createdAt              DateTime   @default(now())
  updatedAt              DateTime   @updatedAt

  driver         User            @relation("DriverRides", fields: [driverId], references: [userId], onDelete: Restrict)
  vehicle        Vehicle         @relation(fields: [vehicleId], references: [vehicleId], onDelete: Restrict)
  communities    RideCommunity[]
  stops          RideStop[]
  route          RideRoute?
  bookings       Booking[]
  fareQuotes     FareQuote[]
  driverEarnings  DriverEarning[]
  safetyIncidents SafetyIncident[]
  sosAlerts       SOSAlert[]
  locations       RideLocation[]
  deviations        RouteDeviationEvent[]
  ratings           Rating[]
  calendarEvents    CalendarEvent[]
  emissionEstimates EmissionEstimate[]

  @@index([driverId])
  @@index([vehicleId])
  @@index([departureTime, rideStatus])
  @@index([rideStatus])
  @@map("rides")
}

model RideCommunity {
  rideCommunityId String   @id @default(uuid()) @db.Uuid
  rideId          String   @db.Uuid
  communityId     String   @db.Uuid
  createdAt       DateTime @default(now())

  ride      Ride      @relation(fields: [rideId], references: [rideId], onDelete: Cascade)
  community Community @relation(fields: [communityId], references: [communityId], onDelete: Cascade)

  @@unique([rideId, communityId])
  @@index([communityId])
  @@map("ride_communities")
}

model RideStop {
  stopId               String    @id @default(uuid()) @db.Uuid
  rideId               String    @db.Uuid
  stopType             StopType  @default(WAYPOINT)
  address              String    @db.VarChar(255)
  latitude             Float
  longitude            Float
  placeId              String?   @db.VarChar(255)
  sequence             Int
  estimatedArrivalTime DateTime?
  createdAt            DateTime  @default(now())

  ride Ride @relation(fields: [rideId], references: [rideId], onDelete: Cascade)

  @@unique([rideId, sequence])
  @@index([rideId])
  @@map("ride_stops")
}

model RideRoute {
  routeId         String   @id @default(uuid()) @db.Uuid
  rideId          String   @unique @db.Uuid
  encodedPolyline String?  @db.Text
  distanceMeters  Int
  durationSeconds Int
  routeProvider   String?  @db.VarChar(50)
  routeMetadata   Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  ride Ride @relation(fields: [rideId], references: [rideId], onDelete: Cascade)

  @@map("ride_routes")
}

// ==========================================
// MODELS (PART 4: BOOKINGS & CANCELLATIONS)
// ==========================================

model Booking {
  bookingId      String        @id @default(uuid()) @db.Uuid
  rideId         String        @db.Uuid
  riderId        String        @db.Uuid
  pickupAddress  String        @db.VarChar(255)
  pickupLat      Float
  pickupLng      Float
  dropoffAddress String        @db.VarChar(255)
  dropoffLat     Float
  dropoffLng     Float
  seatCount      Int           @default(1)
  bookingStatus  BookingStatus @default(PENDING)
  totalFare      Decimal       @db.Decimal(10, 2)
  fareQuoteId    String?       @db.Uuid
  confirmedAt    DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  ride               Ride                @relation(fields: [rideId], references: [rideId], onDelete: Restrict)
  rider              User                @relation("RiderBookings", fields: [riderId], references: [userId], onDelete: Restrict)
  fareQuote          FareQuote?          @relation(fields: [fareQuoteId], references: [quoteId], onDelete: SetNull)
  cancellation       Cancellation?
  noShowRecord       NoShowRecord?
  penaltyAssessments PenaltyAssessment[]
  disputes           DisputeCase[]
  payments           Payment[]
  driverEarning      DriverEarning?
  ratings            Rating[]
  emissionEstimate   EmissionEstimate?

  @@index([rideId])
  @@index([riderId])
  @@index([bookingStatus])
  @@map("bookings")
}

model FareQuote {
  quoteId            String          @id @default(uuid()) @db.Uuid
  rideId             String          @db.Uuid
  riderId            String          @db.Uuid
  quotedAmount       Decimal         @db.Decimal(10, 2)
  status             FareQuoteStatus @default(ACTIVE)
  expiresAt          DateTime
  calculationDetails Json?
  createdAt          DateTime        @default(now())

  ride      Ride           @relation(fields: [rideId], references: [rideId], onDelete: Cascade)
  rider     User           @relation("RiderFareQuotes", fields: [riderId], references: [userId], onDelete: Cascade)
  lineItems FareLineItem[]
  bookings  Booking[]

  @@index([rideId])
  @@index([riderId])
  @@map("fare_quotes")
}

model FareLineItem {
  lineItemId          String           @id @default(uuid()) @db.Uuid
  fareQuoteId         String           @db.Uuid
  itemType            FareLineItemType
  description         String           @db.VarChar(150)
  amount              Decimal          @db.Decimal(10, 2)
  calculationMetadata Json?
  createdAt           DateTime         @default(now())

  fareQuote FareQuote @relation(fields: [fareQuoteId], references: [quoteId], onDelete: Cascade)

  @@index([fareQuoteId])
  @@map("fare_line_items")
}

model CancellationPolicy {
  policyId                      String   @id @default(uuid()) @db.Uuid
  name                          String   @db.VarChar(100)
  description                   String?
  freeCancellationWindowMinutes Int      @default(15)
  penaltyPercentage             Decimal  @default(0) @db.Decimal(5, 2)
  flatPenaltyAmount             Decimal  @default(0) @db.Decimal(10, 2)
  isActive                      Boolean  @default(true)
  createdAt                     DateTime @default(now())
  updatedAt                     DateTime @updatedAt

  cancellations      Cancellation[]
  penaltyAssessments PenaltyAssessment[]

  @@map("cancellation_policies")
}

model Cancellation {
  cancellationId   String           @id @default(uuid()) @db.Uuid
  bookingId        String           @unique @db.Uuid
  cancelledById    String           @db.Uuid
  responsibleParty ResponsibleParty
  reason           String
  penaltyAmount    Decimal          @default(0) @db.Decimal(10, 2)
  policyId         String?          @db.Uuid
  cancelledAt      DateTime         @default(now())
  createdAt        DateTime         @default(now())

  booking           Booking             @relation(fields: [bookingId], references: [bookingId], onDelete: Restrict)
  cancelledBy       User                @relation("CancellationsPerformed", fields: [cancelledById], references: [userId], onDelete: Restrict)
  policy            CancellationPolicy? @relation(fields: [policyId], references: [policyId], onDelete: SetNull)
  penaltyAssessment PenaltyAssessment?

