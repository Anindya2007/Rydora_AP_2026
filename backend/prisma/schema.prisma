  perKmRate                 Decimal   @db.Decimal(10, 2)
  perMinuteRate             Decimal   @db.Decimal(10, 2)
  platformCommissionPercent Decimal   @db.Decimal(5, 2)
  minimumFare               Decimal   @db.Decimal(10, 2)
  surgeMultiplierMax        Decimal   @default(2.00) @db.Decimal(3, 2)
  isActive                  Boolean   @default(true)
  effectiveFrom             DateTime  @default(now())
  effectiveTo               DateTime?
  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt

  @@map("fare_policies")
}
