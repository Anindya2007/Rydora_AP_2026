# Server Environment
PORT=3000
NODE_ENV=development
# Allowed frontend origins for CORS (comma-separated for multiple origins, e.g. http://localhost:5173,http://localhost:3000)
# Wildcard '*' is supported for public non-credentialed access, but credentials require explicit origins
CORS_ORIGIN="http://localhost:5173"

# PostgreSQL Database Connection URL (e.g. Neon or Local PostgreSQL)
DATABASE_URL="postgresql://user:password@localhost:5432/rydora?sslmode=prefer"

# Security & Authentication (minimum 32 characters required)
JWT_SECRET="replace-with-a-secure-random-secret-key-at-least-32-chars"

# Platform Administrator Allowlist (comma-separated user UUIDs)
# Users matching these database user IDs receive application-level ADMIN role upon authentication. Defaults to empty.
ADMIN_USER_IDS=""
