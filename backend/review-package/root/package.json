{
  "name": "rydora-capstone",
  "version": "1.0.0",
  "private": true,
  "description": "Rydora RideShare Ecosystem Capstone",
  "scripts": {
    "postinstall": "cd backend && npx prisma generate",
    "test": "cd backend && npm test",
    "build": "cd backend && npm run build",
    "prisma:status": "cd backend && npx prisma migrate status",
    "prisma:generate": "cd backend && npx prisma generate",
    "prisma:validate": "cd backend && npx prisma validate",
    "prisma:format": "cd backend && npx prisma format",
    "prisma:migrate": "cd backend && npx prisma migrate dev",
    "prisma:studio": "cd backend && npx prisma studio",
    "prisma:push": "cd backend && npx prisma db push"
  },
  "devDependencies": {
    "prisma": "7.10.1"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "dotenv": "^18.0.10",
    "pg": "^8.23.1"
  }
}
